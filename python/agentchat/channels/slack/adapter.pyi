# Public compatibility signatures; update with the corresponding Rust binding API.
import re
from collections.abc import Awaitable, Callable, Mapping, Sequence
from dataclasses import dataclass
from typing import Any, Protocol, TypeVar

from agentchat.channels.base import MessageReceiver
from agentchat.channels.slack.transport import SlackEventSource
from agentchat.models import (
    Answer,
    Attachment,
    DownloadedFile,
    Message,
    Prompt,
    RichReply,
    UploadedFile,
    UploadFile,
)

SlackPayload = Mapping[str, Any]
SlackHandler = Callable[[SlackPayload], Awaitable[Mapping[str, Any] | None]]
_Handler = TypeVar("_Handler", bound=SlackHandler)

@dataclass(frozen=True, slots=True)
class SlackUser:
    id: str
    team_id: str
    display_name: str | None
    email: str | None
    is_bot: bool
    deleted: bool

class ThreadSubscriptions(Protocol):
    async def contains(self, conversation_id: str) -> bool: ...
    async def add(self, conversation_id: str) -> None: ...

class MemoryThreadSubscriptions:
    def __init__(self) -> None: ...
    async def contains(self, conversation_id: str) -> bool: ...
    async def add(self, conversation_id: str) -> None: ...

class SlackWebClient(Protocol):
    async def api_call(self, api_method: str, **kwargs: object) -> Mapping[str, object]: ...
    async def auth_test(self) -> Mapping[str, object]: ...
    async def users_info(self, *, user: str) -> Mapping[str, object]: ...
    async def conversations_replies(self, **kwargs: object) -> Mapping[str, object]: ...
    async def chat_postMessage(self, **kwargs: object) -> Mapping[str, object]: ...
    async def assistant_threads_setStatus(self, **kwargs: object) -> Mapping[str, object]: ...
    async def reactions_add(
        self, *, channel: str, name: str, timestamp: str
    ) -> Mapping[str, object]: ...
    async def chat_postEphemeral(self, **kwargs: object) -> Mapping[str, object]: ...
    async def chat_delete(self, **kwargs: object) -> Mapping[str, object]: ...
    async def views_open(self, **kwargs: object) -> Mapping[str, object]: ...
    async def views_push(self, **kwargs: object) -> Mapping[str, object]: ...
    async def views_update(self, **kwargs: object) -> Mapping[str, object]: ...
    async def views_publish(self, **kwargs: object) -> Mapping[str, object]: ...

class Slack:
    name: str

    def __init__(
        self,
        *,
        bot_token: str,
        app_token: str | None = ...,
        event_source: SlackEventSource | None = ...,
        web_client: SlackWebClient | None = ...,
        ack_emoji: str | None = ...,
        workspace_id: str | None = ...,
        bot_user_id: str | None = ...,
        thread_subscriptions: ThreadSubscriptions | None = ...,
        max_pending_events: int = ...,
        agent_sessions: bool = ...,
    ) -> None: ...
    @property
    def agent_sessions(self) -> bool: ...
    def on_event(self, event_type: str) -> Callable[[_Handler], _Handler]: ...
    def on_action(self, action_id: str | re.Pattern[str]) -> Callable[[_Handler], _Handler]: ...
    def on_view(self, callback_id: str | re.Pattern[str]) -> Callable[[_Handler], _Handler]: ...
    def on_command(self, command: str) -> Callable[[_Handler], _Handler]: ...
    def on_raw(self, handler: _Handler) -> _Handler: ...
    async def open_view(self, trigger_id: str, view: Mapping[str, Any]) -> dict[str, Any]: ...
    async def push_view(self, trigger_id: str, view: Mapping[str, Any]) -> dict[str, Any]: ...
    async def update_view(
        self, view: Mapping[str, Any], *, view_id: str | None = ...,
        external_id: str | None = ..., hash: str | None = ...,
    ) -> dict[str, Any]: ...
    async def publish_home(
        self, user_id: str, view: Mapping[str, Any], *, hash: str | None = ...
    ) -> dict[str, Any]: ...
    async def send_ephemeral(
        self, source: Message, user_id: str, text: str, *,
        blocks: Sequence[Mapping[str, object]] | None = ...,
    ) -> Message: ...
    async def delete(self, message: Message) -> None: ...
    @classmethod
    def from_env(cls, *, ack_emoji: str | None = ...) -> Slack: ...
    def bind(self, receiver: MessageReceiver) -> None: ...
    async def run(self) -> None: ...
    async def close(self) -> None: ...
    async def is_connected(self) -> bool: ...
    async def get_user(self, user_id: str) -> SlackUser: ...
    async def thread_history(self, source: Message, *, limit: int = ...) -> tuple[Message, ...]: ...
    async def subscribe(self, message: Message) -> None: ...
    async def handle_event(self, payload: Mapping[str, object]) -> Mapping[str, object] | None: ...
    async def set_status(self, source: Message, status: str) -> bool: ...
    async def upload_files(
        self, source: Message, files: Sequence[UploadFile]
    ) -> tuple[UploadedFile, ...]: ...
    async def download_attachment(
        self, source: Message, attachment: Attachment, *, max_bytes: int = ...
    ) -> DownloadedFile: ...
    async def reply_rich(self, source: Message, content: RichReply) -> Message: ...
    async def reply(self, source: Message, content: str) -> Message: ...
    stream_interval: float
    stream_limit: int
    async def start_stream(self, source: Message, text: str) -> object: ...
    async def append_stream(self, source: Message, stream: object, text: str) -> object: ...
    async def stop_stream(self, source: Message, stream: object, text: str) -> Message: ...
    async def update_stream_tasks(
        self, source: Message, stream: object | None, updates: Sequence[Mapping[str, object]],
    ) -> object: ...
    async def send_prompt(self, source: Message, prompt: Prompt) -> Message: ...
    async def close_prompt(
        self, source: Message, sent: Message, prompt: Prompt, answer: Answer | None,
    ) -> None: ...
    async def mirror(self, source: Message, message: Message, *, origin: str = ...) -> Message: ...

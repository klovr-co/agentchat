from typing import Any

import aiohttp

API_ROOT: str

class DiscordRESTClient:
    _session: aiohttp.ClientSession | None
    def __init__(self, bot_token: str) -> None: ...
    async def send_text(self, channel_id: int, payload: dict[str, Any]) -> int: ...
    async def edit_text(
        self, channel_id: int, message_id: int, payload: dict[str, Any]
    ) -> None: ...
    async def interaction_callback(
        self, interaction_id: str, token: str, payload: dict[str, Any]
    ) -> None: ...
    async def delete(self, path: str) -> None: ...
    async def open_dm(self, user_id: str) -> int: ...
    async def pins(self, channel_id: int) -> dict[str, Any]: ...
    async def pin(self, channel_id: int, message_id: int) -> None: ...
    async def trigger_typing(self, channel_id: int) -> None: ...
    async def close(self) -> None: ...

from typing import Any

import aiohttp

class BlueBubblesClient:
    server_url: str
    _session: aiohttp.ClientSession | None
    def __init__(self, server_url: str, password: str) -> None: ...
    @property
    def socket_url(self) -> str: ...
    async def request(self, method: str, path: str, **kwargs: object) -> dict[str, Any]: ...
    async def check_connection(self) -> None: ...
    async def send_text(self, chat_guid: str, content: str) -> str: ...
    async def start_typing(self, chat_guid: str) -> bool: ...
    async def close(self) -> None: ...
